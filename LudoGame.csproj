<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <Compile Remove="LudoGame.Tests/**" />
    <Compile Remove="LudoGame.Gui/**" />
    <Compile Remove="LudoGame.Server/**" />
    <Compile Remove="LudoGame.Database/**" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <StartupObject>LudoGameSimulation.Program</StartupObject>
  </PropertyGroup>

  <PropertyGroup>
    <AssemblyTitle>LUDO-T Game Simulation</AssemblyTitle>
    <AssemblyDescription>A comprehensive implementation of the LUDO-T board game simulation with extended rules and intelligent player behaviors.</AssemblyDescription>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Copyright>Copyright © 2026</Copyright>
  </PropertyGroup>

</Project>
